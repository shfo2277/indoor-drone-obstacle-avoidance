<?xml version="1.0"?>
<package format="3">
  <name>planning</name>
  <version>0.1.0</version>
  <description>ROS 2 Offboard Control Node for PX4 with Harmonic Gazebo</description>

  <maintainer email="you@example.com">Your Name</maintainer>
  <license>BSD-3-Clause</license>

